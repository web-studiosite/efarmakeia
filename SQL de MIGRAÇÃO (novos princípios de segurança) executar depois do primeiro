-- =====================================================================
-- FARMAKEIA
-- MIGRAÇÃO DE AUTORIZAÇÃO MULTI-TENANT
--
-- MODELO:
--   SUPER_ADMIN       -> todas as farmácias / administração total
--   UNIVERSAL_CASHIER -> todas as farmácias / operações de caixa
--   ADMIN             -> uma ou várias farmácias
--   JUNIOR_MANAGER    -> uma ou várias farmácias
--   CASHIER           -> exatamente uma farmácia
--
-- NÃO APAGA DADOS DAS TABELAS OPERACIONAIS.
-- =====================================================================


-- =====================================================================
-- 1. ATUALIZAR ENUM DE ROLES DAS FARMÁCIAS
-- =====================================================================

DO $$
BEGIN
    ALTER TYPE public.user_role_type ADD VALUE IF NOT EXISTS 'JUNIOR_MANAGER';
EXCEPTION
    WHEN duplicate_object THEN NULL;
END $$;


-- =====================================================================
-- 2. CRIAR ROLE DE SISTEMA
--
-- system_role NÃO substitui store_users.role.
--
-- system_role:
--   SUPER_ADMIN
--   UNIVERSAL_CASHIER
--   USER
--
-- store_users.role:
--   ADMIN
--   JUNIOR_MANAGER
--   CASHIER
-- =====================================================================

DO $$
BEGIN
    CREATE TYPE public.system_role_type AS ENUM (
        'USER',
        'SUPER_ADMIN',
        'UNIVERSAL_CASHIER'
    );
EXCEPTION
    WHEN duplicate_object THEN NULL;
END $$;


-- =====================================================================
-- 3. ADICIONAR system_role AO PERFIL
-- =====================================================================

ALTER TABLE public.profiles
ADD COLUMN IF NOT EXISTS system_role public.system_role_type
DEFAULT 'USER' NOT NULL;


-- =====================================================================
-- 4. MIGRAÇÃO DOS ROLES ANTIGOS
--
-- ADMIN antigo -> SUPER_ADMIN
-- CASHIER antigo -> USER
--
-- Isto preserva a interpretação do esquema anterior:
-- quem era ADMIN global continua tendo acesso administrativo global.
-- =====================================================================

UPDATE public.profiles
SET system_role = 'SUPER_ADMIN'
WHERE role = 'ADMIN'
  AND system_role = 'USER';


-- =====================================================================
-- 5. GARANTIR QUE O ROLE LOCAL TENHA VALOR VÁLIDO
-- =====================================================================

UPDATE public.profiles
SET role = 'CASHIER'
WHERE role IS NULL;


-- =====================================================================
-- 6. FUNÇÕES CENTRAIS DE AUTORIZAÇÃO
-- =====================================================================


-- ---------------------------------------------------------------------
-- ROLE DE SISTEMA DO UTILIZADOR
-- ---------------------------------------------------------------------

CREATE OR REPLACE FUNCTION public.current_user_system_role()
RETURNS public.system_role_type
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
    SELECT COALESCE(
        (
            SELECT p.system_role
            FROM public.profiles p
            WHERE p.id = auth.uid()
              AND p.active = TRUE
        ),
        'USER'::public.system_role_type
    );
$$;


-- ---------------------------------------------------------------------
-- SUPER ADMIN
-- ---------------------------------------------------------------------

CREATE OR REPLACE FUNCTION public.current_user_is_super_admin()
RETURNS BOOLEAN
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
    SELECT EXISTS (
        SELECT 1
        FROM public.profiles p
        WHERE p.id = auth.uid()
          AND p.system_role = 'SUPER_ADMIN'
          AND p.active = TRUE
    );
$$;


-- ---------------------------------------------------------------------
-- UNIVERSAL CASHIER
-- ---------------------------------------------------------------------

CREATE OR REPLACE FUNCTION public.current_user_is_universal_cashier()
RETURNS BOOLEAN
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
    SELECT EXISTS (
        SELECT 1
        FROM public.profiles p
        WHERE p.id = auth.uid()
          AND p.system_role = 'UNIVERSAL_CASHIER'
          AND p.active = TRUE
    );
$$;


-- ---------------------------------------------------------------------
-- ACESSO À FARMÁCIA
--
-- SUPER_ADMIN       -> qualquer farmácia
-- UNIVERSAL_CASHIER -> qualquer farmácia
-- USER              -> somente store_users
-- ---------------------------------------------------------------------

CREATE OR REPLACE FUNCTION public.current_user_has_store_access(
    check_store_id UUID
)
RETURNS BOOLEAN
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
    SELECT
        public.current_user_is_super_admin()
        OR public.current_user_is_universal_cashier()
        OR EXISTS (
            SELECT 1
            FROM public.store_users su
            WHERE su.store_id = check_store_id
              AND su.user_id = auth.uid()
              AND su.active = TRUE
        );
$$;


-- ---------------------------------------------------------------------
-- ADMIN DE UMA FARMÁCIA ESPECÍFICA
--
-- SUPER_ADMIN também passa.
-- ADMIN local passa somente onde possui role ADMIN.
-- ---------------------------------------------------------------------

CREATE OR REPLACE FUNCTION public.current_user_is_store_admin(
    check_store_id UUID
)
RETURNS BOOLEAN
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
    SELECT
        public.current_user_is_super_admin()
        OR EXISTS (
            SELECT 1
            FROM public.store_users su
            WHERE su.store_id = check_store_id
              AND su.user_id = auth.uid()
              AND su.role = 'ADMIN'
              AND su.active = TRUE
        );
$$;


-- ---------------------------------------------------------------------
-- ADMIN OU JUNIOR MANAGER DE UMA FARMÁCIA
-- ---------------------------------------------------------------------

CREATE OR REPLACE FUNCTION public.current_user_is_store_manager(
    check_store_id UUID
)
RETURNS BOOLEAN
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
    SELECT
        public.current_user_is_super_admin()
        OR EXISTS (
            SELECT 1
            FROM public.store_users su
            WHERE su.store_id = check_store_id
              AND su.user_id = auth.uid()
              AND su.role IN ('ADMIN', 'JUNIOR_MANAGER')
              AND su.active = TRUE
        );
$$;


-- ---------------------------------------------------------------------
-- CAIXA DA FARMÁCIA
--
-- SUPER_ADMIN
-- UNIVERSAL_CASHIER
-- CASHIER daquela farmácia
--
-- ADMIN/JUNIOR_MANAGER também possuem acesso à farmácia, mas isso
-- não os transforma em "caixa".
-- ---------------------------------------------------------------------

CREATE OR REPLACE FUNCTION public.current_user_can_operate_cash(
    check_store_id UUID
)
RETURNS BOOLEAN
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
    SELECT
        public.current_user_is_super_admin()
        OR public.current_user_is_universal_cashier()
        OR EXISTS (
            SELECT 1
            FROM public.store_users su
            WHERE su.store_id = check_store_id
              AND su.user_id = auth.uid()
              AND su.role = 'CASHIER'
              AND su.active = TRUE
        )
        OR EXISTS (
            SELECT 1
            FROM public.store_users su
            WHERE su.store_id = check_store_id
              AND su.user_id = auth.uid()
              AND su.role IN ('ADMIN', 'JUNIOR_MANAGER')
              AND su.active = TRUE
        );
$$;


-- ---------------------------------------------------------------------
-- ROLE LOCAL DO UTILIZADOR NUMA FARMÁCIA
-- ---------------------------------------------------------------------

CREATE OR REPLACE FUNCTION public.current_user_store_role(
    check_store_id UUID
)
RETURNS public.user_role_type
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
    SELECT su.role
    FROM public.store_users su
    WHERE su.store_id = check_store_id
      AND su.user_id = auth.uid()
      AND su.active = TRUE
    LIMIT 1;
$$;


-- =====================================================================
-- 7. PROTEGER A INTEGRIDADE DE store_users
--
-- Um CASHIER normal só pode pertencer a UMA farmácia.
--
-- ADMIN e JUNIOR_MANAGER podem pertencer a várias.
--
-- SUPER_ADMIN / UNIVERSAL_CASHIER não precisam de associação em
-- store_users para obter acesso universal.
-- =====================================================================

CREATE OR REPLACE FUNCTION public.enforce_single_store_cashier()
RETURNS TRIGGER
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN

    IF NEW.role = 'CASHIER' AND NEW.active = TRUE THEN

        IF EXISTS (
            SELECT 1
            FROM public.store_users su
            WHERE su.user_id = NEW.user_id
              AND su.active = TRUE
              AND su.role = 'CASHIER'
              AND su.id <> COALESCE(NEW.id, '00000000-0000-0000-0000-000000000000'::UUID)
        ) THEN
            RAISE EXCEPTION
                'Este utilizador já está associado a uma farmácia como CASHIER. Um CASHIER normal só pode pertencer a uma única farmácia.';
        END IF;

    END IF;

    RETURN NEW;
END;
$$;


DROP TRIGGER IF EXISTS trg_enforce_single_store_cashier
ON public.store_users;

CREATE TRIGGER trg_enforce_single_store_cashier
BEFORE INSERT OR UPDATE OF user_id, role, active, store_id
ON public.store_users
FOR EACH ROW
EXECUTE FUNCTION public.enforce_single_store_cashier();


-- =====================================================================
-- 8. GARANTIR QUE default_store_id PERTENÇA AO UTILIZADOR
-- =====================================================================

CREATE OR REPLACE FUNCTION public.validate_default_store()
RETURNS TRIGGER
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN

    IF NEW.default_store_id IS NOT NULL THEN

        IF NEW.system_role IN ('SUPER_ADMIN', 'UNIVERSAL_CASHIER') THEN
            RETURN NEW;
        END IF;

        IF NOT EXISTS (
            SELECT 1
            FROM public.store_users su
            WHERE su.user_id = NEW.id
              AND su.store_id = NEW.default_store_id
              AND su.active = TRUE
        ) THEN
            RAISE EXCEPTION
                'A farmácia padrão deve pertencer ao utilizador.';
        END IF;

    END IF;

    RETURN NEW;
END;
$$;


DROP TRIGGER IF EXISTS trg_validate_default_store
ON public.profiles;

CREATE TRIGGER trg_validate_default_store
BEFORE INSERT OR UPDATE OF default_store_id, system_role
ON public.profiles
FOR EACH ROW
EXECUTE FUNCTION public.validate_default_store();


